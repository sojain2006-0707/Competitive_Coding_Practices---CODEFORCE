import java.io.*;
import java.util.*;

public class Main {
    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0;
        private int len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0) return -1;
            }
            return buffer[ptr++];
        }

        long nextLong() throws IOException {
            int c;
            do {
                c = read();
            } while (c <= ' ');

            long res = 0;
            while (c > ' ') {
                res = res * 10 + c - '0';
                c = read();
            }
            return res;
        }

        int nextInt() throws IOException {
            return (int) nextLong();
        }
    }

    static class Edge {
        int u, v;

        Edge(int u, int v) {
            this.u = u;
            this.v = v;
        }
    }

    static void solve(int n, long k, StringBuilder out) {
        long top = 0;

        for (int x = 1; x <= n / 2; x++) {
            top += x;
            if (2L * x <= n - 1) {
                top += x;
            }
        }

        top *= 2;

        if ((k & 1) == 1 || k < 2L * (n - 1) || k > top) {
            out.append("-1\n");
            return;
        }

        if (n == 2) {
            out.append("1 2\n");
            return;
        }

        ArrayList<Integer> cnt = new ArrayList<>();
        cnt.add((n - 1) / 2);

        if (n % 2 == 0) {
            cnt.add((n - 1) / 2 + 1);
        } else {
            cnt.add((n - 1) / 2);
        }

        long cur = top / 2;
        long target = k / 2;

        for (int iteration = 0; ; iteration++) {
            int id = iteration % 2;

            if (cnt.get(id) > 1 &&
                    cur - (cnt.get(id) - 1L) >= target) {

                cur -= cnt.get(id) - 1L;

                cnt.add(1);
                cnt.set(id, cnt.get(id) - 1);

            } else if (cnt.get(id) > 1 || cur == target) {

                ArrayList<Edge> edges = new ArrayList<>();
                int vertex = 2;

                int groups = cnt.size();
                int[] start = new int[groups];

                for (int j = 0; j < groups; j++) {
                    start[j] = vertex;

                    if (j != id) {
                        int previous = 1;

                        for (int x = 0; x < cnt.get(j); x++) {
                            edges.add(new Edge(previous, vertex));
                            previous = vertex;
                            vertex++;
                        }
                    } else {
                        int previous = 1;
                        int first = vertex;

                        for (int x = 0; x < cnt.get(j) - 1; x++) {
                            edges.add(new Edge(previous, vertex));
                            previous = vertex;
                            vertex++;
                        }

                        int oldSize = cnt.get(j);
                        int newSize = (int) (oldSize - (cur - target));

                        if (newSize == 1) {
                            edges.add(new Edge(1, vertex));
                        } else {
                            edges.add(new Edge(
                                    first + newSize - 2,
                                    vertex
                            ));
                        }

                        vertex++;
                    }
                }

                TreeSet<long[]> set = new TreeSet<>(
                        (a, b) -> {
                            if (a[0] != b[0]) {
                                return Long.compare(a[0], b[0]);
                            }
                            return Long.compare(a[1], b[1]);
                        }
                );

                for (int j = 0; j < groups; j++) {
                    set.add(new long[]{cnt.get(j), j});
                }

                int[] permutation = new int[n + 1];
                permutation[1] = 1;

                int lastGroup = -1;

                for (int x = 2; x <= n; x++) {
                    long[] it = set.last();

                    if ((int) it[1] == lastGroup) {
                        it = set.lower(it);
                    }

                    int group = (int) it[1];

                    set.remove(it);

                    permutation[start[group]] = x;
                    start[group]++;

                    lastGroup = group;

                    cnt.set(group, cnt.get(group) - 1);

                    set.add(new long[]{
                            cnt.get(group),
                            group
                    });
                }

                for (Edge e : edges) {
                    out.append(permutation[e.u])
                       .append(' ')
                       .append(permutation[e.v])
                       .append('\n');
                }

                return;
            }
        }
    }

    public static void main(String[] args) throws Exception {
        FastScanner fs = new FastScanner();
        StringBuilder out = new StringBuilder();

        int t = fs.nextInt();

        while (t-- > 0) {
            int n = fs.nextInt();
            long k = fs.nextLong();

            solve(n, k, out);
        }

        System.out.print(out);
    }
}
