import java.io.*;
import java.util.*;

public class Main {
    static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
    static StringTokenizer st;

    static int n;
    static ArrayList<Integer>[] graph;

    static String query(ArrayList<Integer> a) throws Exception {
        StringBuilder sb = new StringBuilder();
        sb.append("? ").append(a.size());

        for (int v : a) {
            sb.append(' ').append(v + 1);
        }

        System.out.println(sb);
        System.out.flush();

        String s = br.readLine();

        if (s == null || s.equals("-1")) {
            System.exit(0);
        }

        return s;
    }

    static ArrayList<Integer> work(ArrayList<Integer> a, ArrayList<Integer> b) throws Exception {
        ArrayList<Integer> res = new ArrayList<>();

        if (a.isEmpty() || b.isEmpty()) {
            return res;
        }

        ArrayList<Integer> q = new ArrayList<>(a);
        q.addAll(b);

        String s = query(q);

        for (int i = 0; i < b.size(); i++) {
            if (s.charAt(a.size() + i) == '0') {
                res.add(b.get(i));
            }
        }

        return res;
    }

    static void findEdges(ArrayList<Integer> a, ArrayList<Integer> b) throws Exception {
        if (a.isEmpty() || b.isEmpty()) {
            return;
        }

        if (a.size() == 1) {
            int u = a.get(0);

            for (int v : b) {
                graph[u].add(v);
                graph[v].add(u);
            }

            return;
        }

        int m = a.size() / 2;

        ArrayList<Integer> a1 = new ArrayList<>();
        ArrayList<Integer> a2 = new ArrayList<>();

        for (int i = 0; i < m; i++) {
            a1.add(a.get(i));
        }

        for (int i = m; i < a.size(); i++) {
            a2.add(a.get(i));
        }

        ArrayList<Integer> p1 = work(a1, b);

        HashSet<Integer> inP1 = new HashSet<>(p1);

        ArrayList<Integer> nb = new ArrayList<>();
        ArrayList<Integer> p2 = new ArrayList<>();

        for (int v : b) {
            if (inP1.contains(v)) {
                nb.add(v);
            } else {
                p2.add(v);
            }
        }

        findEdges(a1, p1);

        ArrayList<Integer> temp = work(a2, nb);
        p2.addAll(temp);

        findEdges(a2, p2);
    }

    static void dfs(ArrayList<Integer> a) throws Exception {
        if (a.size() <= 1) {
            return;
        }

        String s = query(a);

        ArrayList<Integer> p1 = new ArrayList<>();
        ArrayList<Integer> p2 = new ArrayList<>();

        for (int i = 0; i < a.size(); i++) {
            if (s.charAt(i) == '0') {
                p2.add(a.get(i));
            } else {
                p1.add(a.get(i));
            }
        }

        dfs(p2);

        int[] color = new int[n];
        Arrays.fill(color, -1);

        ArrayList<Integer>[] parts = new ArrayList[2];
        parts[0] = new ArrayList<>();
        parts[1] = new ArrayList<>();

        ArrayDeque<Integer> queue = new ArrayDeque<>();

        for (int start : p2) {
            if (color[start] != -1) {
                continue;
            }

            color[start] = 0;
            queue.add(start);

            while (!queue.isEmpty()) {
                int u = queue.poll();

                parts[color[u]].add(u);

                for (int v : graph[u]) {
                    if (color[v] == -1) {
                        color[v] = color[u] ^ 1;
                        queue.add(v);
                    }
                }
            }
        }

        for (int i = 0; i < 2; i++) {
            ArrayList<Integer> candidates = work(parts[i], p1);
            findEdges(parts[i], candidates);
        }
    }

    public static void main(String[] args) throws Exception {
        int t = Integer.parseInt(br.readLine().trim());

        while (t-- > 0) {
            n = Integer.parseInt(br.readLine().trim());

            graph = new ArrayList[n];

            for (int i = 0; i < n; i++) {
                graph[i] = new ArrayList<>();
            }

            ArrayList<Integer> all = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                all.add(i);
            }

            dfs(all);

            System.out.println("!");
            System.out.flush();

            for (int u = 0; u < n; u++) {
                for (int v : graph[u]) {
                    if (v > u) {
                        System.out.println((u + 1) + " " + (v + 1));
                    }
                }
            }

            System.out.flush();
        }
    }
}
