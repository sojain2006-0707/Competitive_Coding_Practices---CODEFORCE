import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();

        // Each domino covers 2 squares.
        // Therefore, the maximum number is floor((m * n) / 2).
        int answer = (m * n) / 2;

        System.out.println(answer);

        sc.close();
    }
}
